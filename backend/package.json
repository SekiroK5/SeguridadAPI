{
  "name": "secure-task-manager-api",
  "version": "1.0.0",
  "description": "Secure versioned REST API (Express + PostgreSQL + Prisma) for the Flutter task manager",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
